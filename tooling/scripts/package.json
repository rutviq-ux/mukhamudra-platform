{
  "name": "@ru/scripts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "seed": "tsx src/seed.ts",
    "create-razorpay-plans": "tsx src/create-razorpay-plans.ts",
    "backfill-period-end": "dotenv -e ../../.env -- tsx src/backfill-period-end.ts",
    "backfill-period-end:apply": "dotenv -e ../../.env -- tsx src/backfill-period-end.ts --apply"
  },
  "dependencies": {
    "@ru/db": "workspace:*",
    "@ru/config": "workspace:*",
    "razorpay": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "dotenv-cli": "^7.4.0"
  }
}
