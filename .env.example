# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth / Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_secret
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Ghost CMS
GHOST_URL=http://localhost:2368
GHOST_CONTENT_API_KEY=your_ghost_content_api_key
GHOST_ADMIN_API_KEY=your_ghost_admin_api_key

# Listmonk
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=admin
LISTMONK_API_PASSWORD=admin_password

# WhatsApp Bot (legacy)
WA_BOT_ENABLED=false
WA_BOT_SESSION_PATH=./wa-session

# WhatsApp Cloud API (Meta Business API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Google Workspace
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_PAID_USERS_SHEET_ID=
  GOOGLE_PAID_USERS_TAB=Paid Users
GOOGLE_LEADS_TAB=Leads
GOOGLE_MEET_GROUP_FACE_YOGA=
GOOGLE_MEET_GROUP_PRANAYAMA=

# Recording Folders
PRANAYAMA_RECORDINGS_FOLDER_ID=
MUKHAMUDRA_RECORDINGS_FOLDER_ID=

# Cron Jobs
CRON_SECRET=
