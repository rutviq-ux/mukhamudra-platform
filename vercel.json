{
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @ru/db db:generate:ci && pnpm --filter @ru/web build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/expire-memberships",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-recording-access",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/session-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/generate-sessions",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/complete-sessions",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/send-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-sequences",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retry-messages",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-payments",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-paid-users-sheet",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-subscription-periods",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-whatsapp",
      "schedule": "*/10 * * * *"
    }
  ]
}
